# ElevenLabs Text-to-Speech Configuration
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
REACT_APP_ELEVENLABS_API_KEY=your_api_key_here

# Optional: Override default voice ID
# Find voice IDs at: https://elevenlabs.io/app/voice-library
# Default: EXAVITQu4vr4xnSDxMaL (Sarah - warm narrator voice)
# REACT_APP_ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Optional: Override default model
# Options: eleven_turbo_v2_5, eleven_multilingual_v2, eleven_monolingual_v1
# Default: eleven_turbo_v2_5 (fast, high-quality)
# REACT_APP_ELEVENLABS_MODEL=eleven_turbo_v2_5
